#include<iostream>
using namespace std;
void print(int arr[], int e)
{
    cout<<"size of array " << e << endl;
    for(int i = 0; i < e; i++)
    {
        cout<< arr[i]<<" ";
    }
    cout<<endl;
}

int linear(int arr[], int e, int key)
{
    print(arr, e);
    if(e == 0)
    return false;

    if(arr[0] == key)
    return true;

    return linear(arr + 1, e-1, key);
}

int main()
{
    int arr[5] = {1,2,3,4,5};
    int e = 4;
    int key = 3;
    int ans = linear(arr, e, key);

    if(ans)
    {
       cout<< "key is present";
    }
    else{
         cout<< "key is absent";
    }
}

class Solution {
public:
    bool judgeSquareSum(int c) {
        long long j = sqrt(c);
        long long i = 0; 
        while(i <= j)
        {
            long long squre = i*i + j*j;
            if(squre == c)
            return true;
            else if(squre < c)
            {
                i++;
            }
            else{
                j--;
            }
        }
         return false;
        
    }
};
